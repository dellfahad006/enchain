+		foreach (Material mat in mats)
+		{
+			startAlpha.Add(mat.HasProperty("_Color") ? mat.color.a : 1f);
+		}
+		float t = 0f;
+		while (t < CheckpointFadeTime)
+		{
+			t += Time.deltaTime;
+			float k = 1f - Mathf.Clamp01(t / CheckpointFadeTime);
+			for (int i = 0; i < mats.Count; i++)
+			{
+				if (mats[i] != null && mats[i].HasProperty("_Color"))
+				{
+					Color c = mats[i].color;
+					c.a = startAlpha[i] * k;
+					mats[i].color = c;
+				}
+			}
+			yield return null;
+		}
+		if (cp != null)
+		{
+			cp.SetActive(false);
+		}
+	}
